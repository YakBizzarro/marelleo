	(text "Battery sense divider R10/R11 (to IO1) reads VSYS,\ni.e. 5 V when USB is present (move to VBAT on next rev)."
		(exclude_from_sim no)
		(at 66 227 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "00044511-3168-5e74-8b01-105b8439c969")
	)
	(text "Shutdown latch: the knob switch (J8) pulls SYSOFF low to power up; firmware then holds it low via IO21 -> Q1\n(ARRET_CMD) and releases it to power off. R12 1 M to VBAT pulls SYSOFF up (VBAT is the only rail alive when off).\nEN2 = 1, EN1 = 0: ILIM mode, R8 1.5 k = 1.03 A input limit.  R7 1 k: 890 mA charge.  R9 10 k: TS disabled.\n~{CHG} not connected; ~{CE} and TMR have no connection on the board.  Q1 and D1 need a 180 deg rotation at JLCPCB."
		(exclude_from_sim no)
		(at 12 258 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "04af9ca9-7781-5c2d-9f01-47bf488d298d")
	)
	(text "Card-detect switch unused. The 22 R series\nresistors of the plan were never fitted."
		(exclude_from_sim no)
